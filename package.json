{
  "name": "computer-use",
  "version": "0.1.0",
  "private": true,
  "description": "Computer Use: the desktop operator, its TypeScript packages and the tooling around the Rust workspace",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gen-types": "node scripts/gen-types.mjs",
    "gen-types:check": "node scripts/gen-types.mjs --check",
    "build:native": "node scripts/ensure-binaries.mjs",
    "build:macos-source": "bash scripts/build-macos-source.sh",
    "check:macos-source": "bash scripts/check-macos-source.sh",
    "build:macos-device": "bash scripts/build-macos-device.sh",
    "check:macos-device": "bash scripts/check-macos-device.sh",
    "check:macos-stop-gate": "bash scripts/check-macos-stop-gate.sh",
    "smoke:macos-atomic": "node scripts/smoke-macos-atomic.mjs",
    "smoke:macos-device-pipeline": "node scripts/smoke-macos-device-pipeline.mjs",
    "smoke:macos-click": "node scripts/smoke-macos-click.mjs",
    "smoke:macos-click-death": "node scripts/smoke-macos-click.mjs --death",
    "smoke:macos-position": "node scripts/smoke-macos-position.mjs",
    "probe:macos-menu": "node scripts/probe-macos-menu.mjs",
    "probe:macos-keyboard": "node scripts/probe-macos-keyboard.mjs",
    "smoke:macos-keyboard": "node scripts/smoke-macos-keyboard.mjs",
    "smoke:macos-operator-keyboard": "node --import tsx scripts/smoke-macos-operator-authorization.mts --execute --keyboard",
    "smoke:macos-text-values": "node scripts/smoke-macos-text-values.mjs",
    "smoke:macos-value-workflow": "node scripts/smoke-macos-value-workflow.mjs",
    "smoke:macos-device": "node --import tsx scripts/smoke-macos-device.mjs",
    "smoke:macos-host-engine": "node --import tsx scripts/smoke-macos-host-engine.mts",
    "smoke:macos-operator-authorization": "node --import tsx scripts/smoke-macos-operator-authorization.mts",
    "smoke:macos-operator-toggle": "node --import tsx scripts/smoke-macos-operator-authorization.mts --execute --toggle",
    "smoke:macos-operator-toggle-pointer": "node --import tsx scripts/smoke-macos-operator-authorization.mts --execute --toggle --pointer-only",
    "smoke:macos-model-authorization": "node --import tsx scripts/smoke-macos-model-authorization.mts",
    "build:macos-keychain": "bash scripts/build-macos-keychain.sh",
    "check:macos-keychain": "bash scripts/check-macos-keychain.sh",
    "build:macos-owned-document": "bash scripts/build-macos-owned-document.sh",
    "smoke:macos-owned-document": "node --import tsx scripts/smoke-macos-owned-document.mts",
    "smoke:macos-owned-document-source": "node --import tsx scripts/smoke-macos-owned-document-source.mts",
    "smoke:macos-owned-document-rust-source": "node --import tsx scripts/smoke-macos-owned-document-rust-source.mts",
    "smoke:macos-owned-document-host": "node --import tsx scripts/smoke-macos-owned-document-host.mts",
    "smoke:macos-owned-document-value": "node --import tsx scripts/smoke-macos-owned-document-host.mts --value-readback",
    "smoke:macos-owned-value-input": "node --import tsx scripts/smoke-macos-owned-value-input.mts",
    "smoke:macos-owned-edit-save-reopen": "node --import tsx scripts/smoke-macos-owned-edit-save-reopen.mts",
    "smoke:macos-owned-root-revisit": "node --import tsx scripts/smoke-macos-owned-root-revisit.mts",
    "probe:macos-owned-focus": "node --import tsx scripts/probe-macos-owned-focus.mts --probe",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build:native && npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "smoke:macos-scroll-menu": "node scripts/smoke-macos-scroll-menu.mjs",
    "smoke:macos-operator-scroll": "node --import tsx scripts/smoke-macos-operator-authorization.mts --execute --scroll",
    "smoke:macos-operator-menu": "node --import tsx scripts/smoke-macos-operator-authorization.mts --execute --menu"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
