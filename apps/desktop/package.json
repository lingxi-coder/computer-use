{
  "name": "@computer-use/desktop",
  "productName": "LingXi Control",
  "version": "0.1.0",
  "private": true,
  "description": "LingXi Control Operator: the Electron shell that supervises the native processes and gives the person a way to start, watch and stop a task",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac:local": "node ../../scripts/package-macos-local-app.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@computer-use/decision-worker": "*",
    "@computer-use/desktop-api": "*"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.1.1",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.6"
  }
}
